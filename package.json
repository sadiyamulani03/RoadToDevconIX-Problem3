{
  "name": "bhasha-markets",
  "version": "1.0.0",
  "private": true,
  "description": "Bhasha Markets - multilingual market translation and verification workbench. RoadToDevcon IX, Problem 3.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke-flow.ts",
    "audit": "tsx scripts/audit-acceptance.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "demo:changed-number": "tsx scripts/demo-changed-number.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run scan:secrets && npm run smoke && npm run build"
  },
  "keywords": [
    "translation",
    "localization",
    "verification",
    "prediction-markets",
    "hindi",
    "tamil",
    "marathi",
    "zod",
    "nextjs",
    "roadtodevcon"
  ],
  "author": "Sadiya Mulani",
  "license": "MIT",
  "dependencies": {
    "next": "15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
