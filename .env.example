# ---------------------------------------------------------------------------
# Bhasha Markets - environment example
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env*`.
# Only `.env.example` (this file) is tracked. It contains placeholders only.
# ---------------------------------------------------------------------------

# --- Translation provider (Sarvam AI) ---------------------------------------
# Live translation is enabled only when SARVAM_API_KEY is non-empty.
# Get a key from https://dashboard.sarvam.ai (API Keys section).
# Leave empty to run the clearly-labelled deterministic fixture/demo provider.
SARVAM_API_KEY=

# Sarvam translation endpoint. Override for testing or a compatible gateway.
SARVAM_BASE_URL=https://api.sarvam.ai

# Model: "sarvam-translate:v1" (formal, all 22 scheduled languages, 2000 char
# limit) or "mayura:v1" (1000 char limit). Bhasha Markets defaults to
# sarvam-translate:v1 because formal newsroom text fits that model best.
SARVAM_MODEL=sarvam-translate:v1

# Hard timeout (ms) enforced on every single provider HTTP request.
TRANSLATION_TIMEOUT_MS=30000

# Total attempts per provider request: 1 initial call + (n - 1) retries. Max 5.
TRANSLATION_MAX_ATTEMPTS=3

# --- Provider selection ------------------------------------------------------
# "auto"     -> use Sarvam live when SARVAM_API_KEY is set, fixtures otherwise
# "sarvam"   -> force live Sarvam (errors clearly when the key is missing)
# "fixture"  -> force the deterministic demo fixture provider
TRANSLATION_PROVIDER=auto
